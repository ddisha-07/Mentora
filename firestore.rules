rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public / Read-only Educational Content
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.admin == true;
    }

    match /modules/{moduleId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.admin == true;
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.admin == true;
    }

    match /skills/{skillId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.admin == true;
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.admin == true;
    }

    match /communities/{communityId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.admin == true;
    }

    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.token.admin == true;
    }

    // User Profile and Private User Data
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // User Progress, Skills, and Activity
    match /user_courses/{id} {
      allow read, write: if isAuthenticated();
    }

    match /user_skills/{id} {
      allow read, write: if isAuthenticated();
    }

    match /lesson_progress/{id} {
      allow read, write: if isAuthenticated();
    }

    match /user_streaks/{id} {
      allow read, write: if isAuthenticated();
    }

    match /daily_tasks/{id} {
      allow read, write: if isAuthenticated();
    }

    match /xps/{id} {
      allow read, write: if isAuthenticated();
    }

    // Default Fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
